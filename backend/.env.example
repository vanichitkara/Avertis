# Copy this file to backend/.env and fill in what you have.
#
#   cp backend/.env.example backend/.env
#
# backend/.env is gitignored. Never commit a real key: this repository will be
# shared, and a key committed once stays in the git history even after it is
# deleted from the file.
#
# Everything here is optional. With none of it set, the backend runs on
# deterministic rules and an in-memory store, and says so on /api/v1/health.

# --- Gemini -----------------------------------------------------------------
# Get a key from https://aistudio.google.com/apikey
#
# The key ALONE is not enough — the SDK has to be installed too:
#     .venv/bin/pip install google-genai
# Without it the backend stays on rules and /api/v1/health will tell you so.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# --- Firestore (optional persistence) ---------------------------------------
# Without this the store is in-memory and state is lost on restart.
#     .venv/bin/pip install google-cloud-firestore
#     gcloud auth application-default login
# FIRESTORE_PROJECT=nocturne-502617

# --- Shared key between the mesh and this backend (optional) ----------------
# If set, callers must send it as the X-Avertis-Key header. Leave empty for
# local development.
# AVERTIS_API_KEY=
